{
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/css/*",
      "/js/*",
      "/static/*",
      "/share/*",
      "/favicon.ico",
      "/robots.txt",
      "/sitemap.xml",
      "/api/*"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "cache-control": "no-cache, no-store, must-revalidate"
  }
}
