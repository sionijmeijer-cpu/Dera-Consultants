{
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/css/*",
      "/js/*",
      "/static/*",
      "/share/*",
      "/favicon.ico",
      "/robots.txt",
      "/sitemap.xml",
      "/api/*"
    ]
  },
  "routes": [
    {
      "route": "/share/*",
      "serve": "/share/*",
      "statusCode": 200
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
