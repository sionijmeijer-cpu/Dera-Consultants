{
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/css/*",
      "/js/*",
      "/static/*",
      "/share/*",
      "/favicon.ico",
      "/robots.txt",
      "/sitemap.xml",
      "/api/*"
    ]
  },
  "routes": [
    {
      "route": "/sitemap.xml",
      "headers": {
        "content-type": "application/xml"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
